    "@langchain/textsplitters": "1.0.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "langchain": "1.2.26",
    "mongodb": "7.0.0",
    "mongoose": "9.2.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
